const request = require('supertest');

const app = require('../app');
const pool = require('../db/database');

describe('Monolith Shop API', () => {

    afterAll(async () => {
        await pool.end();
    });


    test('GET / should return API message', async () => {
        const response = await request(app)
            .get('/');

        expect(response.statusCode).toBe(200);

        expect(response.body).toHaveProperty(
            'message',
            'Monolith Shop API is running'
        );
    });


    test('GET /api/products should return products', async () => {
        const response = await request(app)
            .get('/api/products');

        expect(response.statusCode).toBe(200);

        expect(response.body).toHaveProperty('products');

        expect(Array.isArray(response.body.products))
            .toBe(true);
    });


    test('Protected product creation should reject missing token', async () => {
        const response = await request(app)
            .post('/api/products')
            .send({
                name: 'Test Product',
                description: 'Test product',
                price: 1000,
                stock: 10
            });

        expect(response.statusCode).toBe(401);
    });


    test('Protected orders should reject missing token', async () => {
        const response = await request(app)
            .get('/api/orders');

        expect(response.statusCode).toBe(401);
    });


    test('Protected payments should reject missing token', async () => {
        const response = await request(app)
            .get('/api/payments');

        expect(response.statusCode).toBe(401);
    });

});
